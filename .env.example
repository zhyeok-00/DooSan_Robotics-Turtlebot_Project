# Copy this file to .env and set values for your environment.
# Never commit the resulting .env file.
ROS_SETUP=/opt/ros/humble/setup.bash
TB4_SETUP=/path/to/turtlebot4_ws/install/setup.bash
ROBOT_NAMESPACE=robot4
ROBOT_HOST=192.0.2.10
ROBOT_USER=ubuntu
ROBOT_ROS_SETUP=/opt/ros/humble/setup.bash
ROBOT_WORKSPACE_SETUP=/path/to/robot_ws/install/setup.bash
ROBOT_LOG_PATH=/tmp/arduino_shooter.log
ROS_DOMAIN_ID=5
ROS_DISCOVERY_SERVER=';;;;127.0.0.1:11811;'
ROS_SUPER_CLIENT=False
ARDUINO_PORT_GLOB='/dev/ttyACM*'
